# Bhrmshree Environment Configuration

# --- Google Gemini API (Primary) ---
# Use Gemini 3.1 Pro (Latest) for maximum agentic reasoning
GOOGLE_AI_API_KEY=your-gemini-api-key-here
SECURITY_MODEL=gemini-3.1-pro-latest
QA_MODEL=gemini-3.1-pro-latest

# --- Optional Alternative: OpenRouter (Multi-model backup) ---
OPENROUTER_API_KEY=your-openrouter-key-here
ROUTER_DEFAULT=openrouter,google/gemini-2.0-flash-exp

# --- Temporal Configuration ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Automation Settings ---
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
MAX_AGENT_TURNS=100
MAX_CONCURRENT_AGENTS=5

# --- Project Paths ---
REPO_BASE_DIR=/home/Yash/repos
OUTPUT_BASE_DIR=/home/Yash/bhrmshree-results
