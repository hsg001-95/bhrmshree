parse_args() {
  for arg in "$@"; do
    case "$arg" in
      URL=*) URL="${arg#URL=}" ;;
      REPO=*) REPO="${arg#REPO=}" ;;
      ID=*) ID="${arg#ID=}" ;;
    esac
  done
}

cmd_start() {
  parse_args "$@"
  if [ -z "$URL" ] || [ -z "$REPO" ]; then
    echo "ERROR: URL and REPO are required"
    echo "Usage: ./bhrmshree start URL=<url> REPO=<path>"
    exit 1
  fi
  echo "🚀 Launching Bhrmshree Engine for: $URL..."
  # Temporal client logic would go here
  echo "✓ Scan started successfully!"
}

cmd_dashboard() {
  echo "🌍 Launching Bhrmshree Dashboard at http://localhost:3000..."
  # Dashboard launch logic
}

case "${1:-help}" in
  start)
    shift
    cmd_start "$@"
    ;;
  dashboard)
    cmd_dashboard
    ;;
  status)
    echo "Scan status logic coming soon..."
    ;;
  help|--help|-h|*)
    show_help
    ;;
esac
